{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "simpletools",
    "version": "0.1.0",
    "identifier": "com.armut.simpletools",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "simpletools",
                "width": 800,
                "height": 600,
                "alwaysOnTop": true,
                "visible": false,
                "resizable": false,
                "browserExtensionsEnabled": false,
                "center": false,
                "titleBarStyle": "Transparent",
                "transparent": true,
                "decorations": false,
                "visibleOnAllWorkspaces": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
